    "gamma_G6": "rms(u_6_2) / max(rms(u_6_1), epsilon_Q)",
    "gamma_G9": "rms(u_9_2) / max(rms(u_9_1), epsilon_Q)",
    "gamma_delta": "rms(c_2) / max(rms(c_1), epsilon_Q)",
    "cosine_G6": "dot(u_6_1,u_6_2)/(norm(u_6_1)*norm(u_6_2)) when direction gate is active",
    "cosine_G9": "dot(u_9_1,u_9_2)/(norm(u_9_1)*norm(u_9_2)) when direction gate is active",
    "cosine_delta": "dot(c_1,c_2)/(norm(c_1)*norm(c_2)) when direction gate is active",
    "observed_order_G6": "-log2(gamma_G6) when 0 < gamma_G6 and the first increment is above scale",
    "observed_order_G9": "-log2(gamma_G9) when 0 < gamma_G9 and the first increment is above scale",
    "observed_order_delta": "-log2(gamma_delta) when 0 < gamma_delta and c_1 is above scale"
  },
