{
  "schema_version": 1,
  "study_name": "HF3D-Q1 早期瞬态数值筛查",
  "scope": "只筛查三维后端早期受迫瞬态的时间步与网格趋势；不覆盖稳态漏斗、首次触杆或稳定气道",
  "maximum_claim_status": "NUMERICAL_SCREENING_ONLY",
  "base_config": "../../../02_模拟程序/configs/hf_preview_quick.json",
  "case_overrides": {
    "drive.ramp_duration_s": 0.005,
    "run.duration_s": 0.02,
    "run.output_interval_s": 0.001
  },
  "spatial_study": {
    "target_bar_diameter_cells_worst_axis": [
      4.0,
      6.0,
      9.0
    ],
    "common_time_step_s": 2.5e-05,
    "round_to_multiple": 2
  },
  "temporal_study": {
    "target_bar_diameter_cells_worst_axis": 9.0,
    "time_step_s": [
      0.0001,
      5e-05,
      2.5e-05
    ]
  },
  "observables": {
    "smooth": [
      "funnel_depth_m",
      "min_gap_to_bar_m",
      "kinetic_energy_lab_j",
      "angular_momentum_z_kg_m2_s",
      "axisymmetry_error"
    ],
    "binary": [
      "first_contact_proxy",
      "connection_candidate",
      "finite_channel_candidate"
    ]
  },
  "gates": {
    "configuration": {
      "coarsest_bar_diameter_cells_worst_axis_min": 4.0,
      "finest_bar_diameter_cells_worst_axis_min": 8.0,
      "grid_aspect_ratio_max": 1.25,
      "interface_width_cells_worst_axis_min": 2.0,
      "finest_nominal_bar_voxel_count_min": 500.0
    },
    "numerical_quality": {
      "liquid_mass_error_relative_max": 0.001,
      "liquid_volume_balance_error_relative_max": 0.001,
      "pressure_residual_max": 1e-06,
      "projected_divergence_max_s_inv": 0.0001,
      "advective_cfl_max": 0.35,
      "cumulative_phase_clip_relative_max": 0.001,
      "cumulative_phase_repair_relative_max": 0.001
    },
    "smooth_convergence": {
      "relative_l2_max": 0.05,
      "relative_linf_max": 0.1,
      "gci_l2_max": 0.05,
      "observed_order_min": 0.5,
      "gci_safety_factor": 1.25,
      "absolute_scale_floors": {
        "funnel_depth_m": 1e-05,
        "min_gap_to_bar_m": 1e-05,
        "kinetic_energy_lab_j": 1e-08,
        "angular_momentum_z_kg_m2_s": 1e-09,
        "axisymmetry_error": 0.001
      }
    },
    "binary_event": {
      "absolute_time_tolerance_s": 0.002,
      "period_fraction_tolerance": 0.1,
      "duty_fraction_tolerance": 0.1,
      "transition_count_tolerance": 1
    }
  }
}
