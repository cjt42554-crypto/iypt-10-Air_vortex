{
  "schema_version": 1,
  "study_name": "HF3D-Q1R3 探针前设计（开边界库存与守恒拆分）",
  "scope": "用 Q1R2 完整轨迹提出 5.5e-6 s 共同登记步长，并在冻结 Q1R3 前先执行细网格探针；本文件不是 Q1R3 冻结或通过声明",
  "maximum_claim_status": "NUMERICAL_SCREENING_ONLY",
  "execution_requirements": {
    "pressure_accelerator_selected": "cuda"
  },
  "base_config": "formal_candidate/fine_window_pressure_1e-7.json",
  "case_overrides": {
    "drive.ramp_duration_s": 0.005,
    "high_fidelity.cfl_controller_target_fraction": 0.95,
    "high_fidelity.maximum_cfl_step_retries": 4,
    "high_fidelity.pressure_relative_tolerance": 1e-7,
    "high_fidelity.pressure_solver_device": "cuda",
    "run.duration_s": 0.02,
    "run.output_interval_s": 0.001
  },
  "spatial_study": {
    "target_bar_diameter_cells_worst_axis": [
      4.0,
      6.0,
      9.0
    ],
    "common_time_step_s": 5.5e-6,
    "round_to_multiple": 2
  },
  "temporal_study": {
    "target_bar_diameter_cells_worst_axis": 9.0,
    "time_step_s": [
      5.5e-6,
      2.75e-6,
      1.375e-6
    ]
  },
  "observables": {
    "smooth": [
      "funnel_depth_m",
      "min_gap_to_bar_m",
      "kinetic_energy_lab_j",
      "angular_momentum_z_kg_m2_s",
      "axisymmetry_error",
      "liquid_mass_error_relative"
    ],
    "binary": [
      "first_contact_proxy",
      "connection_candidate",
      "finite_channel_candidate"
    ]
  },
  "gates": {
    "refinement_design": {
      "configured_time_step_active_fraction_min": 0.95
    },
    "configuration": {
      "coarsest_bar_diameter_cells_worst_axis_min": 4.0,
      "finest_bar_diameter_cells_worst_axis_min": 8.0,
      "grid_aspect_ratio_max": 1.25,
      "interface_width_cells_worst_axis_min": 2.0,
      "finest_nominal_bar_voxel_count_min": 500.0
    },
    "numerical_quality": {
      "contract_id": "OPEN_BOUNDARY_INVENTORY_CONSERVATION_SPLIT_V1",
      "liquid_inventory_change": {
        "archive_observable": "liquid_mass_error_relative",
        "canonical_name": "liquid_inventory_change_relative",
        "role": "MODEL_DOMAIN_AND_BOUNDARY_INVENTORY_OBSERVABLE",
        "absolute_gate_enabled": false,
        "required_smooth_observable": true,
        "absolute_gate_reason": "NO_CALIBRATED_PHYSICAL_OR_DOMAIN_ADEQUACY_THRESHOLD"
      },
      "liquid_volume_balance_error_relative_max": 0.001,
      "pressure_residual_max": 1e-7,
      "projected_divergence_max_s_inv": 1e-4,
      "advective_cfl_max": 0.35,
      "cumulative_phase_clip_relative_max": 0.001,
      "cumulative_phase_repair_relative_max": 0.001
    },
    "smooth_convergence": {
      "relative_l2_max": 0.05,
      "relative_linf_max": 0.1,
      "gci_l2_max": 0.05,
      "observed_order_min": 0.5,
      "gci_safety_factor": 1.25,
      "absolute_scale_floors": {
        "funnel_depth_m": 1e-5,
        "min_gap_to_bar_m": 1e-5,
        "kinetic_energy_lab_j": 1e-8,
        "angular_momentum_z_kg_m2_s": 1e-9,
        "axisymmetry_error": 0.001,
        "liquid_mass_error_relative": 1e-6
      }
    },
    "binary_event": {
      "absolute_time_tolerance_s": 0.002,
      "period_fraction_tolerance": 0.1,
      "duty_fraction_tolerance": 0.1,
      "transition_count_tolerance": 1
    }
  }
}
